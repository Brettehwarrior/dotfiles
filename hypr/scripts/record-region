#!/usr/bin/env bash

VIDEO_DIR="$HOME/Videos/Recordings"
mkdir -p "$VIDEO_DIR"

if pgrep -x wf-recorder >/dev/null; then
    pkill -INT -x wf-recorder
    notify-send -t 1000 "Recording saved to $VIDEO_DIR"
    exit 0
fi

FILE="$VIDEO_DIR/recording-$(date +%Y%m%d-%H%M%S).mp4"
GEOMETRY="$(slurp)" || exit 0

notify-send -t 1000 "Recording started" "Press the shortcut again to stop"
wf-recorder -g "$GEOMETRY" -f "$FILE" -y

notify-send "Recording saved" "$FILE"
